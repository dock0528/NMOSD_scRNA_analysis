library(clusterProfiler)
gene_list<-rownames(data@assays$RNA@meta.features)
length(gene_list)
gene_df<-bitr(gene_list,fromType = 'SYMBOL',toType=c('ENTREZID','ENSEMBL'),OrgDb='org.Hs.eg.db')
