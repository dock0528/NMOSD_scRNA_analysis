library(biomaRt)
# 連線到 Ensembl
mart <- useMart("ensembl", dataset = "hsapiens_gene_ensembl")
# 你的 gene_list (只有 symbol)
gene_list <- c("AL627309.1", "AL627309.5", "AP006222.2", "LINC01409", "FAM87B", "LINC01128")
# 查表 (symbol → Ensembl ID)
mapping <- getBM(
attributes = c("ensembl_gene_id", "hgnc_symbol", "external_gene_name"),
filters = "external_gene_name",
values = gene_list,
mart = mart
)
head(mapping)
