# 把 cell barcodes 放在 rownames，確保之後 subset 對得上
rownames(qc_df) <- colnames(data)
# 3) 產生「每個 sample 一張表」；列是 criterion、欄是 n_cells / percent
overall_by_sample_long <- qc_df %>%
group_by(sample) %>%
summarise(
`UMI < 1000`          = sum(flag_lowUMI),
`UMI > 99th pct`      = sum(flag_hiUMI),
