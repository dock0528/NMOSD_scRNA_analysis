   "source": [
    "import numpy as np\n",
    "\n",
    "# 自己輸入年齡：空白或逗號分隔都可以，例如： 23 25 31 40  或  23,25,31,40\n",
    "s = input(\"請輸入 age（用空白或逗號分隔）：\").strip()\n",
    "s = s.replace(\",\", \" \")\n",
    "ages = np.array([float(x) for x in s.split()])\n",
    "\n",
    "mean_age = ages.mean()\n",
    "sd_age = ages.std(ddof=1)  # 樣本標準差\n",
    "\n",
    "print(f\"{mean_age:.2f} ± {sd_age:.2f}\")\n"
   ]
  },
